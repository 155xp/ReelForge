    [32.6, 36.0, "The ground shook first. The blast is still miles away."],
    [36.4, 39.8, "It's moving at about 1,000 miles per hour."],
    [40.2, 43.4, "Now there are fires everywhere."],
    [43.7, 46.7, "The cloud is still rising."],
    [47.0, 50.0, "Every car on the street has stopped."],
